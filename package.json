{
  "name": "dsh-plugin-dm8-inspect",
  "version": "0.1.0",
  "private": true,
  "description": "达梦 DM8 数据库巡检插件：注册 dm8_inspect 工具，执行 85 项只读巡检并生成 HTML 报告。",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shiyuedong-Jade/DM-inspect.git"
  },
  "homepage": "https://github.com/Shiyuedong-Jade/DM-inspect#readme",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
